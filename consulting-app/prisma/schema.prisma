generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  TEAM_ADMIN
  TEAM_MEMBER
  CLIENT
}

enum AccessLevel {
  FULL
  READ_ONLY
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

// Typ der Aufgabe — bestimmt, welche Zusatzfelder in `metadata` erwartet werden
// und in welcher Gruppe sie auf der Objektseite erscheint.
enum TaskCategory {
  LEASE_ANALYSIS   // Mietvertraganalyse
  MAINTENANCE      // Wartung (metadata: gewerk, intervalMonths, contractor, lastCheckedAt, nextCheckAt)
  DEADLINE         // Frist / Termin (metadata: source, recurring)
  DEFECT           // Mangel / Schaden (metadata: location, severity, photos)
  NKA              // Nebenkostenabrechnung (metadata: period)
  AMENDMENT        // Nachtrag (metadata: version)
  REPORTING        // Reporting-Pflicht (metadata: recipient, cadence)
  HANDOVER         // Übergabe (metadata: handoverDate)
  CORRESPONDENCE   // Schriftwechsel
  GENERIC          // Allgemein
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Visibility {
  INTERNAL
  SHARED_WITH_CLIENT
}

enum EmailDirection {
  IN
  OUT
}

enum ThreadStatus {
  OPEN
  ARCHIVED
}

// Auth.js Standard-Modelle
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          Role      @default(TEAM_MEMBER)
  createdAt     DateTime  @default(now())

  accounts          Account[]
  sessions          Session[]
  projectMemberships ProjectMember[]
  assignedTasks     Task[]            @relation("TaskAssignee")
  authoredNotes     Note[]
  uploadedDocuments Document[]
  authoredMessages  Message[]
  assignedThreads   EmailThread[]     @relation("ThreadAssignee")
  authoredPropertyNotes PropertyNote[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Domain-Modelle
model Client {
  id        String   @id @default(cuid())
  name      String
  company   String?
  email     String?
  phone     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects   Project[]
  properties Property[]
  tasks      Task[]
}

// Objekt = ein vom Mandanten betreutes Mietobjekt (z.B. Lagerhalle, Bürogebäude).
// Ein Mandant hat 1..n Objekte. Pro Objekt fallen die typischen Themen an:
// Mietvertraganalyse, Wartung, Fristen, Mängel, NKA, Übergabe, Nachträge.
model Property {
  id          String    @id @default(cuid())
  clientId    String
  name        String    // z.B. "Dieselstraße 72-90"
  address     String?
  city        String?
  postalCode  String?
  description String?   @db.Text
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  client       Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lease        Lease?
  tasks        Task[]
  notes        PropertyNote[]
  emailThreads EmailThread[]

  @@index([clientId])
}

// Mietvertrag als strukturiertes Datenobjekt (statt nur PDF-Anhang).
// Phase 3: KI extrahiert die Felder + Pflichten aus dem PDF.
model Lease {
  id              String    @id @default(cuid())
  propertyId      String    @unique
  landlord        String?   // Vermieter
  tenant          String?   // Mieter (meist = Mandantenfirma)
  signedAt        DateTime?
  startDate       DateTime?
  endDate         DateTime?
  hasOption       Boolean   @default(false)
  optionDetails   String?
  monthlyRent     Decimal?  @db.Decimal(10, 2)
  indexClause     String?   // Wertsicherung/Indexierung in Stichworten
  noticePeriod    String?   // Kündigungsfrist in Stichworten
  analysisStatus  String    @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED
  notesMarkdown   String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

// Notiz auf Objekt-Ebene (für Begehungs-Protokolle, Kommentare).
model PropertyNote {
  id         String   @id @default(cuid())
  propertyId String
  authorId   String
  title      String
  content    String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([propertyId, createdAt])
}

model Project {
  id          String        @id @default(cuid())
  clientId    String
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)
  deadline    DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  client       Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  members      ProjectMember[]
  tasks        Task[]
  notes        Note[]
  documents    Document[]
  messages     Message[]
  emailThreads EmailThread[]
}

model ProjectMember {
  projectId   String
  userId      String
  accessLevel AccessLevel @default(FULL)
  addedAt     DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
}

// Aufgabe — hängt entweder direkt an einem Objekt (typischer Fall),
// am Mandanten (Sales/Akquise, mandantenweite Themen) oder optional an einem
// Projekt (klassischer Auftrag). Mindestens eine Verknüpfung muss gesetzt sein.
// `category` schaltet das passende UI-Detail-Panel frei; `metadata` hält
// typ-spezifische Zusatzfelder.
model Task {
  id          String       @id @default(cuid())
  projectId   String?
  clientId    String?
  propertyId  String?
  title       String
  description String?      @db.Text
  category    TaskCategory @default(GENERIC)
  status      TaskStatus   @default(TODO)
  priority    Priority     @default(MEDIUM)
  assigneeId  String?
  dueDate     DateTime?
  metadata    Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project  Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client   Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  assignee User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([propertyId, status])
  @@index([clientId, status])
  @@index([assigneeId, status])
  @@index([category, status])
}

model Note {
  id         String     @id @default(cuid())
  projectId  String
  authorId   String
  title      String
  content    String     @db.Text
  visibility Visibility @default(INTERNAL)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Restrict)
}

model Document {
  id           String     @id @default(cuid())
  projectId    String
  uploadedById String
  filename     String
  storageKey   String
  mimeType     String
  sizeBytes    Int
  visibility   Visibility @default(INTERNAL)
  createdAt    DateTime   @default(now())

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
}

// Phase 2: zentrale Team-Inbox
model EmailAccount {
  id           String    @id @default(cuid())
  label        String
  email        String    @unique
  username     String
  // Hinweis: App-Passwort, vorerst im Klartext — Server gehört uns selbst.
  // Verschlüsselung at-rest ist als Folgeschritt im README vermerkt.
  password     String
  imapHost     String
  imapPort     Int       @default(993)
  imapSecure   Boolean   @default(true)
  smtpHost     String
  smtpPort     Int       @default(587)
  smtpSecure   Boolean   @default(false)
  uidValidity  String?
  lastUid      Int?
  lastSyncAt   DateTime?
  lastSyncError String?
  createdAt    DateTime  @default(now())

  threads  EmailThread[]
  messages EmailMessage[]
}

model EmailThread {
  id                String       @id @default(cuid())
  accountId         String
  projectId         String?
  propertyId        String?
  assigneeId        String?
  subject           String
  normalizedSubject String
  status            ThreadStatus @default(OPEN)
  unread            Boolean      @default(true)
  lastMessageAt     DateTime
  createdAt         DateTime     @default(now())

  account  EmailAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  project  Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  property Property?      @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  assignee User?          @relation("ThreadAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages EmailMessage[]

  @@index([accountId, status, lastMessageAt])
  @@index([projectId])
  @@index([propertyId])
  @@index([accountId, normalizedSubject])
}

model EmailMessage {
  id        String         @id @default(cuid())
  threadId  String
  accountId String
  direction EmailDirection
  messageId String?        @unique // RFC-5322 Message-ID, für Threading + Dedupe
  inReplyTo String?
  fromAddr  String
  toAddr    String
  ccAddr    String?
  subject   String
  textBody  String         @db.Text
  htmlBody  String?        @db.Text
  sentAt    DateTime
  createdAt DateTime       @default(now())

  thread      EmailThread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  account     EmailAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  attachments EmailAttachment[]

  @@index([threadId, sentAt])
}

model EmailAttachment {
  id         String @id @default(cuid())
  messageId  String
  filename   String
  storageKey String
  mimeType   String
  sizeBytes  Int

  message EmailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

// Phase-3-Stub: Chat-Messages (Schema bereits da, UI später)
model Message {
  id        String   @id @default(cuid())
  projectId String
  authorId  String
  content   String   @db.Text
  channel   String   @default("INTERNAL") // INTERNAL | WITH_CLIENT
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Restrict)
}
