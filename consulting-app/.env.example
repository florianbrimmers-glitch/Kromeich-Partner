# Postgres (matches docker-compose.yml)
DATABASE_URL="postgresql://consulting:consulting@localhost:5432/consulting?schema=public"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="change-me-in-production"
AUTH_URL="http://localhost:3000"

# E-Mail (lokal: Mailpit aus docker-compose; in Production: euer SMTP-Server)
EMAIL_SERVER_HOST="localhost"
EMAIL_SERVER_PORT="1025"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="noreply@consulting.local"

# Komma-getrennte Liste der Team-Admin-Emails (werden bei erstem Login automatisch als TEAM_ADMIN angelegt)
TEAM_ADMIN_EMAILS="admin@example.com"
