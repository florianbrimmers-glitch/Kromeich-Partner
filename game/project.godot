; Godot 4.x Projekt-Skelett fuer Kromeich Heroes.
; Wird beim ersten Oeffnen in Godot vervollstaendigt.

config_version=5

[application]

config/name="Kromeich Heroes"
config/description="Rundenbasiertes HoMM3-inspiriertes Handyspiel. Async-Multiplayer."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.2", "C#", "Mobile")
config/icon="res://assets/icon.svg"

[dotnet]

project/assembly_name="KromeichHeroes"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="mobile"
