; Godot 4.5 Projekt fuer Kromeich Heroes.
; Reine GDScript-App. C# crasht auf Android 15 + Snapdragon 8 Elite
; (Samsung S25 Ultra), siehe Diagnose in Commits d5388a6..fbd7c35.
; Die C#-Dateien in scripts/ bleiben fuer Desktop-Unit-Tests und den
; Balance-Simulator erhalten, werden aber von keiner Szene geladen
; und "C#" ist aus config/features entfernt, damit die .NET-Runtime
; auf Android gar nicht erst gestartet wird.

config_version=5

[application]

config/name="Kromeich Heroes"
config/description="Rundenbasiertes HoMM3-inspiriertes Handyspiel. Async-Multiplayer."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.5", "Mobile")
config/icon="res://assets/icon.svg"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

; gl_compatibility (GLES3) statt Vulkan-Mobile: robuster auf Android,
; insbesondere auf Samsung-Geraeten mit One UI.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
