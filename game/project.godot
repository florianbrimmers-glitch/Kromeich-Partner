; Godot 4.x Projekt-Skelett fuer Kromeich Heroes.
; Wird beim ersten Oeffnen in Godot vervollstaendigt.

config_version=5

[application]

config/name="Kromeich Heroes"
config/description="Rundenbasiertes HoMM3-inspiriertes Handyspiel. Async-Multiplayer."
; DIAG: SafeMode.tscn ist eine reine GDScript-Startseite ohne C#, um zu
; testen ob der Android-Crash vom .NET-Runtime-Laden kommt. Wenn diese
; Szene startet, wissen wir: nur C# ist das Problem, Godot selbst laeuft.
; Zurueck auf Main.tscn, sobald die Diagnose durch ist.
run/main_scene="res://scenes/SafeMode.tscn"
config/features=PackedStringArray("4.4", "C#", "Mobile")
config/icon="res://assets/icon.svg"

[dotnet]

project/assembly_name="KromeichHeroes"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

; DIAG: gl_compatibility statt "mobile" (Vulkan-Mobile). Vulkan-Treiber
; sind auf manchen Android-Geraeten kaputt und crashen beim Bootstrap.
; OpenGL ES 3 ist der kompatibelste Renderer.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
