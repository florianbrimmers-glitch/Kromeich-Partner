; Godot 4.6 Projekt fuer Kromeich Heroes.
; Reine GDScript-App. Historie: C# crashte auf Android 15 + Snapdragon 8
; Elite (Samsung S25 Ultra), siehe Diagnose in Commits d5388a6..fbd7c35.
; Der C#/Python-Prototyp wurde danach komplett nach GDScript portiert und
; die Altdateien entfernt (Git-History hat sie weiterhin).
;
; ACHTUNG: `godot --import` schreibt diese Datei neu und WIRFT KOMMENTARE
; WEG. Nach jedem Import gehoert ein `git diff project.godot` dazu; in
; It. 53 waren die beiden Begruendungen unten schon einmal verschwunden.

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Kromeich Heroes"
config/description="Rundenbasiertes HoMM3-inspiriertes Handyspiel. Async-Multiplayer."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://assets/icon.svg"

[autoload]

SaveManager="*res://scripts/core/SaveManager.gd"
Sfx="*res://scripts/core/Sfx.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]

; gl_compatibility (GLES3) statt Vulkan-Mobile: robuster auf Android,
; insbesondere auf Samsung-Geraeten mit One UI. Die 3D-Weltkarte (It. 53)
; ist darauf ausgelegt - flaechige Modelle, zwei Richtungslichter, keine
; Schattenkarten.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
