<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>KromeichHeroes</RootNamespace>
    <AssemblyName>KromeichHeroes</AssemblyName>
    <!-- Godot fuegt beim Oeffnen automatisch Godot.NET.Sdk hinzu. -->
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="scripts/**/*.cs" />
    <Compile Remove="scripts/**/obj/**" />
    <Compile Remove="scripts/**/bin/**" />
  </ItemGroup>
</Project>
