# Godot
.godot/
.import/
export.cfg
# Asset-/Script-Metadata wird beim --import frisch erzeugt (lokal und in
# CI); committen wuerde nur Reibung erzeugen, solange wir nicht aktiv mit
# UID-Referenzen arbeiten.
*.uid
*.svg.import
# export_presets.cfg enthaelt Android-Build-Konfig (ohne Secrets) und
# wird versioniert. Lokale Keystore-Pfade sollten ueber Umgebungsvariablen
# in GitHub Actions kommen.

# .NET / C#
bin/
obj/
*.user
*.suo

# Python
__pycache__/
*.pyc
.pytest_cache/

# Pilot (It. 71): heruntergeladene CC0-Pakete und daraus erzeugte Modelle.
